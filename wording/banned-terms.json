{
  "schema": "yunzhi.banned-terms/1",
  "version": "0.2.0",
  "updated": "2026-09-29",
  "about": "弹卡前的机器扫描用：硬名单里任何一条在用户文案字段里命中，这张卡就退回 agent 重写。软名单只给人工抽查，不进机器判定（scanner 只在 advise:true 时把它列为提醒，不影响 ok）。0.2.0 = 修补单 01 的 W 组：卡片上的引文只认与用户原话逐字相符的（Wb1）、「任务书」进硬名单（Wb2）、扫描前先归一写法变体（Wb3）、研究用语不误报（Wb4）。",
  "source": "云织CIS/10-v0.2桌面版/03-用户可见文字盘点.md §3.5 硬黑名单草案。origin=03§3.5 的组逐条来自草案；origin=glossary 的组是从 glossary.json 的「改 / 藏」行补的；origin=decision 的组来自已定的改名。",
  "scan_scope": {
    "scanned": "卡片的 header / question / detail / options[].label / options[].description；界面字典的值；模板的可见文字",
    "not_scanned": [
      "卡片的 id、approve 以及 quotes / references / citations / sources 字段",
      "《》里的标题",
      "网址（本机地址 127.0.0.1 / localhost / file: 除外，它们单独报 env:local-link）",
      "「」“”\"\"『』里、以及 markdown 引用块（行首为 >）里与用户原话（userText）逐字相符的内容；引用块逐行核对",
      "只有自由聊天文字（scanText 且 quoteCues:true）才认提示词：紧跟在「原话 / 原文 / 你说 / 你提到 / 委托里」这类词后面的引号或引用块。卡片和界面字典一律不认"
    ],
    "note": "引号、引用块本身都不算豁免：agent 也会用 > 写提示、用引号标自己的术语。卡片上只有证明是用户原话（归一后逐字出现在 userText 里）才跳过；没传 userText 就一处也不跳过。"
  },
  "quote_cues": {
    "about": "只在宽松模式（scanText 且 quoteCues:true，给自由聊天文字用）里生效：引号前 12 个字以内（同一行），或引用块前一行的末尾 / 引用块第一行的开头出现这些词，就把引号或引用块里的内容当作用户原话、不扫。卡片（scanCard / scanPayload）和界面字典（scanStrings）不接受宽松模式。",
    "window": 12,
    "words": ["原话", "原文", "你说", "你提到", "你写", "你问", "你的说法", "你用的词", "你们的说法", "委托里", "委托中", "委托说明", "你的委托"],
    "not_cues": ["原文件", "原文档"],
    "not_cues_about": "含有提示词、但说的是别的东西的词：「原文件」「原文档」是 agent 自己的文件，不是用户原话（W 验收的例子就是这样漏过去的）。"
  },
  "boundaries": {
    "ascii-word": "前后不能紧挨 ASCII 字母、数字或下划线（相当于草案里的 \\b，但不受中文字符影响）",
    "none": "按子串匹配"
  },
  "forms_about": "组上写 plurals:true 的，纯字母的英文词也认复数 -s / -es（arguments、hashes）；不规则的写在该词的 forms 里（thesis → theses）。英文词里的空格认任意空白（on hold）。",
  "titles_about": "《》里的标题照旧不扫：真实文献标题里常有看起来像内部词的字（Survey、闸门、管线、任务书、预注册、秒批、边界层……）。只有标了 in_titles 的词在《》里也算 —— 我们自造的词与机器名字（对接窗口、落章、判断三行、task_plan、gate1_awaiting、cite_check、.md、{#commitments} 这类）不会出现在真实文献的标题里（W3-2）。「任务书」也标了 in_titles（复核，Selina 9-30）：它是弃用的旧说法，卡片上的《…任务书》多半是 agent 在说任务计划；真实文献的标题由用户原话核对放行 —— 整个《》标题逐字出现在某一条 userText 里，就算用户的（skipped 记 title-verified）。",
  "except_about": "except = 复合词例外（字面，命中的词在这个复合词里就不算）；except_re = 领域用法例外（正则，匹配到的一段盖住命中的词就不算），每条带 example：这句不加例外会被标、加了不会（测试逐条核对）。except_re 默认沿用该词的 flags，可单独写 flags。两种例外都在归一后的文字上判断。",
  "normalize": {
    "about": "扫描前先把写法变体归一（src/normalize.mjs）：逐字 NFKC（全角转半角；圈码 ①、上下标、分数保留原样）、去掉零宽字符 / 软连字符 / BOM / 方向控制符 / 异体选择符、U+3164 这类看起来空白的填充符当空格、去掉两个汉字之间的空白（一个换行也算，空一行不算）、再按下表把繁体字转成简体。命中位置仍报原文里的位置。",
    "traditional_about": "只收硬 / 软名单与例外里用到的字（加上几个常见异体：僞、彙、匯、註、誌、綫、証）。键是只在繁体里用的字，不会改动简体文字。",
    "traditional": {
      "對": "对", "報": "报", "過": "过", "蓋": "盖", "預": "预", "註": "注", "冊": "册", "閘": "闸", "門": "门",
      "斷": "断", "徑": "径", "諾": "诺", "輪": "轮", "彈": "弹", "約": "约", "線": "线", "條": "条", "態": "态",
      "紀": "纪", "庫": "库", "會": "会", "話": "话", "誌": "志", "證": "证", "偽": "伪", "僞": "伪", "體": "体",
      "匯": "汇", "彙": "汇", "編": "编", "綜": "综", "結": "结", "論": "论", "邊": "边", "層": "层", "記": "记",
      "雙": "双", "級": "级", "聯": "联", "決": "决", "準": "准", "術": "术", "壞": "坏", "義": "义", "構": "构",
      "檢": "检", "腳": "脚", "機": "机", "綠": "绿", "數": "数", "務": "务", "書": "书",
      "項": "项", "寬": "宽", "據": "据", "題": "题", "廢": "废", "節": "节", "點": "点",
      "與": "与", "電": "电", "製": "制", "簽": "签", "審": "审", "氣": "气", "熱": "热", "產": "产", "業": "业",
      "動": "动", "設": "设", "場": "场", "館": "馆", "廣": "广", "費": "费", "賽": "赛", "娛": "娱", "樂": "乐",
      "應": "应", "資": "资", "車": "车", "標": "标", "譽": "誉", "評": "评", "調": "调", "給": "给", "認": "认",
      "規": "规", "範": "范", "種": "种", "農": "农", "國": "国", "個": "个", "圍": "围", "跡": "迹", "綫": "线", "証": "证"
    }
  },
